{
  "expo": {
    "name": "License Generator",
    "slug": "license-generator",
    "version": "2.0.0",
    "scheme": "licensegen",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock License Generator"
        }
      ]
    ],
    "android": {
      "package": "com.arian6575000.licensegenerator",
      "versionCode": 2,
      "allowBackup": false
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}